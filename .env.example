# Misskey Instance Configuration
MISSKEY_ORIGIN=https://misskey.io
MISSKEY_TOKEN=your_misskey_access_token_here
MISSKEY_VISIBILITY=public

# WebSocket Endpoints
WOLFX_WS_URL=wss://ws-api.wolfx.jp/jma_eew
P2P_WS_URL=wss://api.p2pquake.net/v2/ws

# Optional Settings
ALLOW_TRAINING=false
ONLY_FIRST_AND_FINAL=true
RECONNECT_INTERVAL_MS=5000

# Health check / automatic process restart
HEALTH_PORT=3000
UNHEALTHY_RESTART_AFTER_MS=120000
